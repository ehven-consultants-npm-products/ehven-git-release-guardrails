{
  "name": "@ehven/git-release-guardrails",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "description": "Portable Git release guards with verified backups, guarded retirement and recovery.",
  "author": "Ehventerprise LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehven-consultants-npm-products/ehven-git-release-guardrails.git"
  },
  "homepage": "https://github.com/ehven-consultants-npm-products/ehven-git-release-guardrails#readme",
  "bugs": {
    "url": "https://github.com/ehven-consultants-npm-products/ehven-git-release-guardrails/issues"
  },
  "keywords": ["git", "branch-retirement", "release", "backup", "recovery", "cli"],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./node": {
      "types": "./src/node/index.d.mts",
      "import": "./src/node/index.mjs"
    }
  },
  "files": [
    "src",
    "bin",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "bin": {
    "ehven-git-release-guardrails": "bin/git-release-guardrails.mjs"
  }
}
